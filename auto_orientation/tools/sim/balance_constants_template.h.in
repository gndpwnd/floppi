/* ============================================================================
 * AUTO-GENERATED BY tools/sim/brute_tune.py — DO NOT HAND-EDIT
 * ============================================================================
 *
 * Regenerate with:
 *   python3 tools/sim/brute_tune.py --mode {mode} --budget {budget} \
 *                                   --output <this-file>
 *
 * Generated:    {timestamp}
 * Generator:    brute_tune.py v{generator_version}
 * Search:       mode={mode}  budget={budget}  seed={seed}
 * Plant preset: {plant_preset}
 * Fitness:      {fitness:.3f}   ({tip_time_s:.3f}s balanced, tip={tipped})
 * Trial:        init_perturbation={init_perturbation_deg}deg,
 *               disturbance={disturbance_mag}
 *
 * Reference for context (SelfBallancingRobot3.ino, manually-tuned working bot):
 *   Kp=65  Ki=12  Kd=38  PITCH_OFFSET=-8.6  PWM_MAX=255
 *
 * This header is the contract between the offline Python brute-force tuner
 * and the on-MCU minimal balance application. The tuner runs a chassis
 * simulation, searches Kp/Ki/Kd by exhaustive scan against an objective
 * (settling time, overshoot, control effort), and rewrites THIS FILE with
 * the winning constants. The build then flashes them to the Uno.
 *
 * Workflow:
 *   1. cd auto_orientation/tools/sim && python3 brute_tune.py
 *   2. pio run -e arduino_uno_minimal
 *   3. pio run -e arduino_uno_minimal -t upload
 *   4. bench-test, iterate
 *
 * Hardware assumptions baked into these values:
 *   - IMU: BNO055 in NDOF fusion mode at I2C 0x28, ~100 Hz internal rate
 *   - Motors: small DC + L298N, ~6-9 V supply, hobby gearbox
 *   - PWM range: ±255 (8-bit analogWrite)
 *   - PID sample period: 5 ms (200 Hz, via MsTimer2)
 *
 * Re-tune when ANY of these change:
 *   - Battery voltage shifts more than ~15%
 *   - Wheels, gearbox, or motors swapped
 *   - Chassis mass redistributed (mounting the IMU higher/lower changes Kd)
 *   - Tether attached/detached (the cable acts as a spring + damper)
 */

#ifndef BALANCE_CONSTANTS_H
#define BALANCE_CONSTANTS_H

#include <stdint.h>

// ----------------------------------------------------------------------------
// PID gains  (TUNED — overwritten by brute_tune.py)
// ----------------------------------------------------------------------------
// Reference .ino values (hand-tuned, Mega + BNO055 + L298N):
//   Kp = 65, Ki = 12, Kd = 38
static const float BALANCE_KP = {kp:.4f}f;
static const float BALANCE_KI = {ki:.4f}f;
static const float BALANCE_KD = {kd:.4f}f;

// ----------------------------------------------------------------------------
// Mounting offset  (TUNED — overwritten by brute_tune.py)
// ----------------------------------------------------------------------------
// Operator-measured mechanical balance angle, in degrees of pitch. The PID
// drives (raw_pitch - PITCH_OFFSET) toward zero. Reference .ino used -8.6°.
// Re-measure when the IMU is remounted or the chassis is rebuilt.
static const float PITCH_OFFSET_DEG = {offset:.4f}f;

// ----------------------------------------------------------------------------
// Loop timing  (FIXED — not tuned by brute_tune.py)
// ----------------------------------------------------------------------------
// 5 ms = 200 Hz, matches the reference .ino's PID.SetSampleTime(5).
static const uint16_t PID_SAMPLE_MS = {pid_sample_ms};

// ----------------------------------------------------------------------------
// Output limits & stiction
// ----------------------------------------------------------------------------
// PID output is clamped to [PWM_MIN, PWM_MAX]. PWM_MAX is TUNED by
// brute_tune.py; PWM_MIN is set to -PWM_MAX to keep the range symmetric
// (motor driver interprets the sign as direction).
static const int16_t PWM_MIN = {pwm_min};
static const int16_t PWM_MAX = {pwm_max};

// Below this PWM magnitude the motors hum but do not turn. Reference .ino
// snapped sub-threshold outputs up to ±15. Set to 0 to disable.
// FIXED — not tuned by brute_tune.py (matches the trial-simulation stiction
// floor so the deployed gains see the same dead-band the tuner assumed).
static const uint8_t STICTION_PWM = {stiction_pwm};

// ----------------------------------------------------------------------------
// Safety  (FIXED — not tuned by brute_tune.py; these are SAFETY limits)
// ----------------------------------------------------------------------------
// If |corrected_pitch| exceeds this, the bot is considered tipped over; motors
// are stopped and the loop refuses to drive them until pitch returns within
// the threshold (no sticky FALLEN state — simpler is better here).
static const float TIP_CUTOFF_DEG = {tip_cutoff_deg:.4f}f;

// Sanity-reject any raw pitch reading whose magnitude exceeds this. Matches
// the reference .ino's `abs(rawPitch) < 90` guard against gimbal-lock / NaN.
static const float PITCH_SANITY_DEG = {pitch_sanity_deg:.4f}f;

#endif  // BALANCE_CONSTANTS_H
